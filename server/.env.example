# Copy this file to .env and fill in real values. .env is gitignored — never commit it.

# Neon gives you two connection strings for the same database:
#   - a POOLED one (hostname ends in "-pooler") — use this for normal app queries,
#     since it goes through PgBouncer and handles many short-lived connections well
#     (important for serverless/Functions, still fine for a long-running server like this one).
#   - a DIRECT one (no "-pooler") — Prisma Migrate needs this one, because schema
#     changes don't work reliably through the pooler.
# Both are on your Neon project's dashboard under "Connection Details".
DATABASE_URL="postgresql://<user>:<password>@<endpoint>-pooler.<region>.aws.neon.tech/<database>?sslmode=require"
DIRECT_URL="postgresql://<user>:<password>@<endpoint>.<region>.aws.neon.tech/<database>?sslmode=require"

PORT=5000

# Image uploads (from the Edit page) go to Cloudinary rather than a local
# folder or Firebase Storage. Find these three values on your Cloudinary
# dashboard homepage (cloudinary.com/console) under "API Keys" — no need to
# construct anything, they're shown to you directly after signup.
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
